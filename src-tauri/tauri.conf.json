{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mojiroku",
  "version": "0.7.1",
  "identifier": "com.daichi0812.mojiroku",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "mojiroku",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "backgroundColor": "#0e1014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; font-src 'self'; object-src 'none'",
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "license": "AGPL-3.0-or-later",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    },
    "copyright": "Copyright (C) 2026 daichi8120",
    "homepage": "https://mojiroku.com",
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/mojiroku-llm",
      "binaries/mojiroku-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mojiroku.com/updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNzQ1OEMwRUU4NTkwOTQKUldTVWtJWHV3RmgwR3QyK3RrVXQ1RmthKzlnK01EU1lnbnFqUkJ5OXVZREliS2RXVTI2bDQ0eHAK"
    }
  }
}
